                <mxCell id="performance" value="&lt;div style=&quot;text-align:center;&quot;&gt;Performance&lt;br&gt;efficiency&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#A78BFA;fontSize=18;fontColor=#1F2937;align=center;verticalAlign=middle;" parent="1" vertex="1">
