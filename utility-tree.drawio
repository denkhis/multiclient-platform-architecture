                </mxCell>
                <mxCell id="security" value="Security" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#A78BFA;fontSize=18;fontColor=#1F2937;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="90" y="370" width="210" height="90" as="geometry"/>
